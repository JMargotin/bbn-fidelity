// Prisma schema for BBN Fidelity.
// Datasource URL is provided via prisma.config.ts (which loads .env.local through dotenv).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Authentication models (managed by better-auth)
// ============================================================================

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  emailVerified      Boolean  @default(false)
  name               String
  image              String?
  role               Role     @default(STAFF)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  accounts             Account[]
  sessions             Session[]
  transactionsCreated  Transaction[]      @relation("TransactionCreatedBy")
  transactionsReversed Transaction[]      @relation("TransactionReversedBy")
  redemptions          RewardRedemption[]
}

enum Role {
  OWNER
  STAFF
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================================
// Business models
// ============================================================================

model Customer {
  id          String    @id @default(cuid())
  firstName   String
  phoneE164   String    @unique
  pointsTotal Int       @default(0)
  // Customer-facing web login (espace fidélité). PIN is a 4-digit code, hashed
  // with scrypt. A null pinHash means "still the default PIN" (1234) — set for
  // legacy customers created before web login existed.
  pinHash           String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  transactions   Transaction[]
  redemptions    RewardRedemption[]
  passDevices    PassDevice[]
  contestEntries ContestEntry[]

  @@index([deletedAt])
}

model Transaction {
  id                   String    @id @default(cuid())
  customerId           String
  amountEurCents       Int
  pointsCredit         Int
  createdByEmployeeId  String
  createdAt            DateTime  @default(now())
  reversedAt           DateTime?
  reversedByEmployeeId String?

  customer   Customer @relation(fields: [customerId], references: [id])
  createdBy  User     @relation("TransactionCreatedBy", fields: [createdByEmployeeId], references: [id])
  reversedBy User?    @relation("TransactionReversedBy", fields: [reversedByEmployeeId], references: [id])

  @@index([customerId, createdAt])
  @@index([createdAt])
}

model Reward {
  id              String   @id @default(cuid())
  label           String
  thresholdPoints Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions RewardRedemption[]
}

model RewardRedemption {
  id                  String   @id @default(cuid())
  customerId          String
  rewardId            String
  pointsDebit         Int // snapshot of threshold at redemption time
  createdByEmployeeId String
  createdAt           DateTime @default(now())

  customer  Customer @relation(fields: [customerId], references: [id])
  reward    Reward   @relation(fields: [rewardId], references: [id])
  createdBy User     @relation(fields: [createdByEmployeeId], references: [id])

  @@index([customerId, createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  email     String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([email, createdAt])
}

model PassDevice {
  id                      String   @id @default(cuid())
  customerId              String
  deviceLibraryIdentifier String
  pushToken               String
  passTypeIdentifier      String
  serialNumber            String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([deviceLibraryIdentifier, passTypeIdentifier, serialNumber])
  @@index([serialNumber])
  @@index([customerId])
}

// Annonce diffusée aux porteurs de carte Apple Wallet. La plus récente est
// embarquée dans la carte (champ avec changeMessage) ; sa diffusion déclenche
// la notification sur l'écran verrouillé via un push APNs vers tous les appareils.
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  deviceCount Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ============================================================================
// Jeu-concours
// ============================================================================

// Un jeu-concours à tickets. Les tickets s'achètent avec les points de
// fidélité (pointsPerTicket) et restent valables pour TOUS les tirages du
// concours : le compteur de tickets d'un participant ne redescend jamais.
model Contest {
  id              String   @id @default(cuid())
  name            String
  prizeLabel      String
  startsAt        DateTime
  endsAt          DateTime
  pointsPerTicket Int      @default(5)
  // Tickets offerts d'office lors de la première participation.
  freeTickets     Int      @default(1)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries ContestEntry[]
  draws   ContestDraw[]

  @@index([active, startsAt])
}

// Participation d'un client à un concours. `tickets` est le total courant
// (offerts + achetés) ; il sert de poids lors du tirage au sort.
model ContestEntry {
  id          String   @id @default(cuid())
  contestId   String
  customerId  String
  tickets     Int      @default(0)
  pointsSpent Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contest   Contest                 @relation(fields: [contestId], references: [id], onDelete: Cascade)
  customer  Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  purchases ContestTicketPurchase[]
  wins      ContestDraw[]

  @@unique([contestId, customerId])
  @@index([contestId])
  @@index([customerId])
}

enum ContestTicketSource {
  FREE
  PURCHASE
}

// Journal d'attribution des tickets (audit : qui a eu quoi, quand, pour
// combien de points). Le total vit sur ContestEntry.tickets.
model ContestTicketPurchase {
  id          String              @id @default(cuid())
  entryId     String
  quantity    Int
  pointsSpent Int
  source      ContestTicketSource @default(PURCHASE)
  createdAt   DateTime            @default(now())

  entry ContestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
}

// Un tirage hebdomadaire. `position` ordonne les tirages (1, 2, 3...).
// Les champs *At-draw sont des instantanés conservés pour l'audit.
model ContestDraw {
  id            String    @id @default(cuid())
  contestId     String
  position      Int
  label         String
  scheduledFor  DateTime
  drawnAt       DateTime?
  winnerEntryId String?
  // Instantanés au moment du tirage (traçabilité du résultat).
  winnerTickets Int?
  totalTickets  Int?
  winningTicket Int?

  contest     Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  winnerEntry ContestEntry? @relation(fields: [winnerEntryId], references: [id])

  @@unique([contestId, position])
  @@index([contestId, scheduledFor])
}
